{
  "name": "zod-rosetty",
  "version": "5.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "bun x bunup",
    "lint": "oxlint src test bunup.config.ts",
    "format": "oxfmt --write src test bunup.config.ts tsconfig.json .oxlintrc.json",
    "format:check": "oxfmt --check src test bunup.config.ts tsconfig.json .oxlintrc.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "typecheck": "tsc --noEmit"
  },
  "author": "qlaffont",
  "repository": {
    "type": "git",
    "url": "https://github.com/qlaffont/zod-rosetty.git"
  },
  "bugs": {
    "url": "https://github.com/qlaffont/zod-rosetty/issues",
    "email": "contact@qlaffont.fr"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@formatjs/intl-durationformat": "^0.10.8",
    "@types/bun": "^1.3.13",
    "bunup": "^0.16.31",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "rosetty": "^5.0.0",
    "typescript": "^6.0.3"
  }
}